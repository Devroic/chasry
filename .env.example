# ── Supabase (Project Settings → API) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Developers → API keys) ────────────────────────────────────────
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Product → Pricing: the recurring EUR 10/month Price id (price_...)
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Resend (API Keys) ──────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be a verified sending domain/address in Resend
RESEND_FROM_EMAIL="Chasry <reminders@chasry.com>"

# ── Cron ────────────────────────────────────────────────────────────────
# Long random string. Also set as the value Vercel Cron sends in its
# Authorization header (Project Settings → Cron Jobs) — see README.
CRON_SECRET=

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Rate limiting (Upstash Redis, optional but recommended) ──────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Error monitoring (Sentry) ─────────────────────────────────────────────
# DSN is public by design (it ships in client JS) — safe to commit.
# Without it the SDK no-ops, so local dev needs no Sentry account.
NEXT_PUBLIC_SENTRY_DSN=
# Secret. Only needed to upload source maps so production stack traces are
# readable instead of minified. Create at Sentry > Settings > Auth Tokens
# with the project:releases scope. Set in .env.local AND in Vercel.
SENTRY_AUTH_TOKEN=
