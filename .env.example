# Next.js
NEXT_PUBLIC_APP_URL=
ADMIN_EMAILS=
# 32+ random chars; signs the "I've paid" / mark-paid email links. Links are omitted if unset.
LINK_SIGNING_SECRET=

# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Chasry <reminders@chasry.com>"

# Upstash (rate limiting; a no-op when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (no-op when unset; auth token is build-time only, for source maps)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cron (32+ random chars; Vercel sends it automatically to the cron routes)
CRON_SECRET=
